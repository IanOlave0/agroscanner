# Variables de entorno de la app (copiar a .env)

# ── Supabase (runtime) ─────────────────────────────────────────
# Crear un proyecto en https://supabase.com y ejecutar supabase/schema.sql
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=TU_ANON_KEY

# ── Mapbox (runtime, Fase de mapas) ────────────────────────────
# Token público (pk.*) desde https://account.mapbox.com/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.TU_TOKEN
